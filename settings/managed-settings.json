{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "ENFORCED, user-immutable policy. Deliver to the managed-settings path as a root-owned, non-user-writable file via MDM (see README.md for per-OS paths). This file is self-contained: it does not rely on any project or user settings. The deny rules and hooks here are layer L3/L4 in SECURITY.md and cover the built-in file tools; the OS boundary is the devcontainer egress firewall and the bash sandbox. IMPORTANT: before trusting this file, run ../test/verify.sh and complete the 'Lockdown keys to verify' checklist in README.md against your installed Claude Code version.",

  "includeCoAuthoredBy": false,
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {},

  "disableBypassPermissionsMode": "disable",

  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },

  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.oci/**)",
      "Read(~/.docker/**)",
      "Read(~/.ssh/**)",
      "Read(//etc/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pgpass)",
      "Read(**/.terraformrc)",
      "Edit(~/.aws/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.ssh/**)",
      "Edit(**/*.tfstate)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(~/.aws/**)",
      "Write(~/.azure/**)",
      "Write(~/.config/gcloud/**)",
      "Write(~/.kube/**)",
      "Write(~/.ssh/**)",
      "Bash(aws:*)",
      "Bash(aws-vault:*)",
      "Bash(az:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(bq:*)",
      "Bash(doctl:*)",
      "Bash(linode-cli:*)",
      "Bash(scw:*)",
      "Bash(ibmcloud:*)",
      "Bash(aliyun:*)",
      "Bash(oci:*)",
      "Bash(eksctl:*)",
      "Bash(kubectl:*)",
      "Bash(oc:*)",
      "Bash(argocd:*)",
      "Bash(flux:*)",
      "Bash(pulumi:*)",
      "Bash(vault:*)",
      "Bash(op:*)",
      "Bash(doppler:*)",
      "Bash(sops:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(terraform login:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(docker push:*)",
      "Bash(docker login:*)",
      "Bash(docker pull:*)",
      "Bash(skopeo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(telnet:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(socat:*)",
      "WebFetch",
      "WebSearch"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          { "type": "command", "command": "/opt/claude-code-devops-kit/hooks/guard-credentials.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/opt/claude-code-devops-kit/hooks/guard-cloud-cli.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
